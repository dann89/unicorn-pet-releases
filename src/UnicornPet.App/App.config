<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
  </startup>
  <appSettings>
    <!-- Where the app looks for signed releases. Change this to move the hosting; the signature check is unaffected. -->
    <add key="UpdateManifestUrl" value="https://github.com/dann89/unicorn-pet-releases/releases/latest/download/manifest.json"/>
  </appSettings>
</configuration>
