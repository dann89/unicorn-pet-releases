<UserControl x:Class="UnicornPet.App.BubbleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" CornerRadius="14" Background="#FFFFFF" BorderBrush="#F4A6C8" BorderThickness="2" Padding="14,10">
            <TextBlock x:Name="Message" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxWidth="240" FontFamily="Segoe UI" FontSize="14" Foreground="#4A3550"/>
        </Border>
        <Polygon x:Name="Tail" Grid.Row="1" Points="0,0 18,0 9,6" Fill="#F4A6C8" HorizontalAlignment="Left" Height="6" Margin="0,-2,0,0"/>
    </Grid>
</UserControl>
