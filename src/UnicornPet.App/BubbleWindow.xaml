<Window x:Class="UnicornPet.App.BubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UnicornPet.App"
        Title="Unicorn bubble" SizeToContent="WidthAndHeight"
        AllowsTransparency="True" Background="Transparent" WindowStyle="None"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        UseLayoutRounding="True">
    <local:BubbleControl x:Name="Bubble"/>
</Window>
